{
  "spec_version": 4,
  "executable": "/home/runner/.cargo/bin/cargo",
  "args": [
    "check",
    "--locked",
    "--workspace",
    "--all-features",
    "--all-targets"
  ],
  "working_directory": "/home/runner/work/stillyard/stillyard",
  "environment": {
    "set": {
      "HOME": "/home/runner",
      "CARGO_HOME": "/home/runner/.cargo",
      "RUSTUP_HOME": "/home/runner/.rustup",
      "RUSTUP_TOOLCHAIN": "stable-x86_64-unknown-linux-gnu",
      "PATH": "/home/runner/.cargo/bin:/usr/bin:/bin",
      "CARGO_TARGET_DIR": "/home/runner/work/stillyard/stillyard/target/scheduled-linux",
      "CARGO_BUILD_JOBS": "4"
    }
  },
  "resources": {
    "cargo_slots": 1,
    "impacts": [
      "cpu_heavy"
    ]
  },
  "timeout_seconds": 1800,
  "labels": [
    {
      "key": "project",
      "value": "stillyard"
    },
    {
      "key": "gate",
      "value": "native-linux-check"
    }
  ]
}
