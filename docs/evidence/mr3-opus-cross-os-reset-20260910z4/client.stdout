                },
                "root_exit_code": 0,
                "exit_classification": "accepted",
                "executable_hash": "52e0a13e60a981d8c4b6478be2ba5176f69da07948a056bf49cf6f077e30cb41",
                "daemon_generation": "01a08a42-318c-7b21-9091-aa0de1d8b4b4",
                "started_unix_millis": 1789027781616,
                "finished_unix_millis": 1789027781809,
                "containment": {
                  "containment_id": "01a089b1-9a6a-7711-a600-39e2b74e495d~01a08a5d-8b59-7253-88ae-1a9721cb4340",
