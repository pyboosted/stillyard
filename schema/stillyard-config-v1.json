{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostConfig",
  "type": "object",
  "properties": {
    "impact_incompatibilities": {
      "description": "Directed declarations interpreted symmetrically by admission.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": {}
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EnvironmentProfile"
      },
      "default": {}
    },
    "resources": {
      "$ref": "#/$defs/ResourceCapacities",
      "default": {
        "cargo_slots": 0,
        "cpu_units": 0,
        "custom": {},
        "gpu_slots": 0,
        "ram_mb": 0
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "EnvironmentProfile": {
      "type": "object",
      "properties": {
        "locked_set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "locked_unset": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "unset": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ResourceCapacities": {
      "description": "Scalar capacities configured by the owner for one host-local daemon.",
      "type": "object",
      "properties": {
        "cargo_slots": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "cpu_units": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "custom": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "default": {}
        },
        "gpu_slots": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "ram_mb": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
